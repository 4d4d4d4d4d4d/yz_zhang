# Read-only RPC credentials can be here (0600); never put a signing key in the indexer.
CHAIN_RPC_URL=https://rpc.example.invalid
CHAIN_MANIFEST=/etc/opc-chain/escrow-deployment.json
CHAIN_INDEX_DATABASE=/var/lib/opc-chain/escrow.sqlite
CHAIN_CONTRACT_TYPE=TaskEscrow
# Prometheus node_exporter textfile collector can be configured to read this directory.
CHAIN_INDEX_METRICS=/var/lib/opc-chain/escrow.prom
# Optional unique snapshots by confirmed height/hash; establish a retention policy.
# CHAIN_INDEX_BACKUP=/var/lib/opc-chain/escrow-backup

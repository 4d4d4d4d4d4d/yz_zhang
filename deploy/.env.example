# DEP-002 生产环境变量模板
#
#   cp deploy/.env.example deploy/.env  然后逐项填写
#   标 【必须修改】 的项不改，deploy/up.sh 会直接拒绝启动。

# ── 数据库 ────────────────────────────────────────────────
POSTGRES_USER=taskplat
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD      # 【必须修改】
POSTGRES_DB=taskplat

# ── 密钥（用 openssl rand -hex 32 生成）────────────────────
PLATFORM_JWT_SECRET=CHANGE_ME                    # 【必须修改】登录令牌签名密钥
PLATFORM_JOB_TOKEN=CHANGE_ME                     # 【必须修改】cron/指标端点共享密钥

# ── 外部供应商（19 号 spec）────────────────────────────────
# 生产环境这四项**不得**保持 mock/local，否则启动自检直接失败。
# 具体可选值取决于你在 app/vendors/registry.py 里登记了哪些实现。
PLATFORM_PAYMENT_PROVIDER=mock                   # 【必须修改】接持牌支付通道
PLATFORM_SMS_PROVIDER=mock                       # 【必须修改】接短信服务商
PLATFORM_KYC_PROVIDER=mock                       # 【必须修改】接实名核验
PLATFORM_MODERATION_PROVIDER=local               # 【必须修改】接内容安全
PLATFORM_STORAGE_PROVIDER=local                  # 接对象存储/CDN
# 可选值：mock/local（退化实现）、sandbox（形态真实的桩，仍不得上生产）、
# 或你登记的真实供应商名。生产环境对 mock 与 sandbox 一视同仁地拒绝启动。

# FIN-052 资金事实来源。internal = 平台自建账本，涉嫌资金池与二清，
# 生产环境会被 startup_check 拒绝启动。接持牌机构存管后改为 custody。
PLATFORM_LEDGER_BACKEND=internal                 # 【必须修改】

# LAW-001/010 法律效力。platform = 平台见证签名，不构成《电子签名法》的
# 可靠电子签名；local = 自算哈希链，无第三方背书。接 CA / 司法存证后替换。
PLATFORM_SIGNATURE_PROVIDER=platform
PLATFORM_NOTARY_PROVIDER=local

# LAW-030 协议版本号。**改了这个值，所有用户在下一次发布/报名/托管/提现前
# 都会被要求重新同意**——所以只在协议文本真的变更时改，
# 且改之前先把新文本上线，否则用户会被要求同意一份看不到的新协议。
PLATFORM_AGREEMENT_VERSION=2026-08-01

# TAX-001 个税方案。**必须显式决定**，否则生产启动自检直接失败：
# 平台向自然人支付报酬即为扣缴义务人，应扣未扣将被处应扣未扣税款 50%~3 倍罚款。
#   withholding   = 平台代扣（再选下面的 TAX_PROVIDER）
#   self_declared = 执行方为个体户/企业，自行申报并开票，平台不扣
PLATFORM_TAX_MODE=none                           # 【必须修改】
#   labor_income            = 劳务报酬预扣预缴（20%~40% 累进，无需执行方办手续）
#   commissioned_collection = 经营所得委托代征（税负低，但**须先与税务机关签
#                             委托代征协议**，没有协议就按这个税率扣是另一种违法）
PLATFORM_TAX_PROVIDER=none
PLATFORM_TAX_COLLECTION_RATE_BPS=100             # 委托代征核定征收率，1% = 100

# ── 站点 ──────────────────────────────────────────────────
PLATFORM_CORS_ORIGINS=https://your-domain.example # 【必须修改】不要留 *
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# SEC-001 TLS 证书目录（需含 fullchain.pem 与 privkey.pem）
TLS_CERT_DIR=./certs                             # 【必须修改】证书由你提供
PLATFORM_LOG_LEVEL=INFO
PLATFORM_GIT_SHA=

# ── 可选 ──────────────────────────────────────────────────
# 设置后启用真实 LLM 任务分解；不设则用模板引擎
ANTHROPIC_API_KEY=

# ── 备份 ──────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
